document.addEventListener('DOMContentLoaded', function() {
    // заменить
    const BASE_API_URL = 'https://';
    
    // Получаем контексты для графиков
    const ctx = document.getElementById('attendanceChart').getContext('2d');
    const pieCtx = document.getElementById('pieChart').getContext('2d');
    
    // Конфигурация данных
    const config = {
        colors: {
            primary: 'rgba(30, 136, 229, 1)',
            primaryLight: 'rgba(30, 136, 229, 0.2)',
            danger: 'rgba(255, 99, 132, 0.8)'
        }
    };
    
    // Текущее состояние приложения
    let state = {
        currentRoom: null,
        rooms: [],
        currentDate: document.getElementById('date').value,
        peopleData: [],
        selectedTimeIndex: 0,
        timeLabels: []
    };
    
    // Инициализация графиков с пустыми данными
    const attendanceChart = new Chart(ctx, {
        type: 'line',
        data: { labels: [], datasets: [] },
        options: getMainChartOptions()
    });

    const pieChart = new Chart(pieCtx, {
        type: 'pie',
        data: { labels: [], datasets: [] },
        options: getPieChartOptions()
    });

    // Функция для загрузки данных с сервера
    async function fetchData() {
        try {
            // Показываем индикатор загрузки
            document.getElementById('loadingIndicator').style.display = 'block';
            
            // Загрузка списка аудиторий
            const roomsResponse = await fetch(`${BASE_API_URL}/rooms`, {
                headers: getAuthHeaders()
            });
            
            if (!roomsResponse.ok) {
                throw new Error(`HTTP error! status: ${roomsResponse.status}`);
            }
            
            state.rooms = await roomsResponse.json();
            
            // Заполняем select аудиториями
            const roomSelect = document.getElementById('room');
            roomSelect.innerHTML = '';
            state.rooms.forEach(room => {
                const option = document.createElement('option');
                option.value = room.id;
                option.textContent = `${room.name} (${room.capacity} мест)`;
                roomSelect.appendChild(option);
            });
            
            // Загружаем данные для первой аудитории
            if (state.rooms.length > 0) {
                state.currentRoom = state.rooms[0].id;
                await loadRoomData(state.currentRoom);
            }
        } catch (error) {
            console.error('Ошибка загрузки данных:', error);
            showError(`Произошла ошибка при загрузке данных: ${error.message}`);
        } finally {
            document.getElementById('loadingIndicator').style.display = 'none';
        }
    }

    // Загрузка данных для конкретной аудитории
    async function loadRoomData(roomId) {
        try {
            document.getElementById('loadingIndicator').style.display = 'block';
            
            const response = await fetch(`${BASE_API_URL}/attendance?room=${roomId}&date=${state.currentDate}`, {
                headers: getAuthHeaders()
            });
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            
            state.timeLabels = data.timeLabels;
            state.peopleData = data.attendanceData;
            
            // Обновляем графики
            updateCharts();
        } catch (error) {
            console.error('Ошибка загрузки данных аудитории:', error);
            showError(`Ошибка загрузки данных аудитории: ${error.message}`);
        } finally {
            document.getElementById('loadingIndicator').style.display = 'none';
        }
    }

    // Получение заголовков авторизации
    function getAuthHeaders() {
        const token = localStorage.getItem('authToken');
        return token ? { 'Authorization': `Bearer ${token}` } : {};
    }

    // Показать ошибку
    function showError(message) {
        const errorElement = document.getElementById('errorMessage');
        errorElement.textContent = message;
        errorElement.style.display = 'block';
        
        setTimeout(() => {
            errorElement.style.display = 'none';
        }, 5000);
    }

    // Обновление графиков с текущими данными
    function updateCharts() {
        // Основной график
        attendanceChart.data.labels = state.timeLabels;
        attendanceChart.data.datasets = [{
            label: 'Количество людей',
            data: state.peopleData,
            backgroundColor: config.colors.primaryLight,
            borderColor: config.colors.primary,
            borderWidth: 2,
            tension: 0.4,
            fill: true,
            pointBackgroundColor: config.colors.primary,
            pointHoverRadius: 6
        }];
        
        // Находим текущую аудиторию
        const currentRoom = state.rooms.find(r => r.id === state.currentRoom);
        if (currentRoom) {
            attendanceChart.options.scales.y.max = currentRoom.capacity;
        }
        
        attendanceChart.update();
        updatePieChart(state.selectedTimeIndex);
    }

    // Обновление круговой диаграммы
    function updatePieChart(index) {
        if (state.peopleData.length === 0) return;
        
        state.selectedTimeIndex = index;
        const selectedTime = state.timeLabels[index];
        const present = state.peopleData[index];
        
        // Находим текущую аудиторию
        const currentRoom = state.rooms.find(r => r.id === state.currentRoom);
        if (!currentRoom) return;
        
        const total = currentRoom.capacity;
        const absent = total - present;
        const presentPercentage = Math.round((present / total) * 100);
        
        // Обновляем данные диаграммы
        pieChart.data.labels = ['Присутствовали', 'Отсутствовали'];
        pieChart.data.datasets = [{
            data: [present, absent],
            backgroundColor: [config.colors.primary, config.colors.danger],
            borderWidth: 1
        }];
        pieChart.update();
        
        // Обновляем текстовую информацию
        document.getElementById('selectedTime').textContent = selectedTime;
        document.getElementById('totalSeats').textContent = total;
        document.getElementById('presentCount').textContent = present;
        document.getElementById('attendancePercent').textContent = `${presentPercentage}%`;
    }

    // Обработчики событий
    function setupEventListeners() {
        // Изменение аудитории
        document.getElementById('room').addEventListener('change', async function() {
            state.currentRoom = this.value;
            await loadRoomData(state.currentRoom);
        });

        // Изменение даты
        document.getElementById('date').addEventListener('change', async function() {
            state.currentDate = this.value;
            if (state.currentRoom) {
                await loadRoomData(state.currentRoom);
            }
        });
        
        // Клик по графику
        ctx.canvas.addEventListener('click', function(event) {
            const elements = attendanceChart.getElementsAtEventForMode(
                event, 'nearest', { intersect: true }, true
            );
            if (elements.length > 0) {
                updatePieChart(elements[0].index);
            }
        });
        
        // Кнопка выхода
        document.querySelector('.logout-button').addEventListener('click', function() {
            localStorage.removeItem('authToken');
            window.location.href = '/logout';
        });
        
        // Навигация в сайдбаре
        document.querySelectorAll('nav a').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const target = this.getAttribute('href').substring(1);
                navigateTo(target);
            });
        });
    }
    
    // Навигация между страницами
    function navigateTo(page) {
        switch(page) {
            case 'users':
                window.location.href = '/users';
                break;
            case 'rooms':
                window.location.href = '/rooms';
                break;
            case 'statistics':
                // Уже на этой странице
                break;
            default:
                console.warn('Неизвестная страница:', page);
        }
    }

    // Настройки основного графика
    function getMainChartOptions() {
        return {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'Количество людей'
                    }
                },
                x: {
                    title: {
                        display: true,
                        text: 'Время'
                    }
                }
            },
            plugins: {
                legend: {
                    position: 'top',
                },
                tooltip: {
                    mode: 'index',
                    intersect: false,
                    callbacks: {
                        label: function(context) {
                            const currentRoom = state.rooms.find(r => r.id === state.currentRoom);
                            const total = currentRoom ? currentRoom.capacity : 0;
                            return `${context.dataset.label}: ${context.raw} из ${total}`;
                        }
                    }
                }
            },
            elements: {
                point: {
                    hoverRadius: 6,
                    radius: 4
                }
            }
        };
    }

    // Настройки круговой диаграммы
    function getPieChartOptions() {
        return {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'top',
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                            const percentage = Math.round((context.raw / total) * 100);
                            return `${context.label}: ${context.raw} (${percentage}%)`;
                        }
                    }
                }
            }
        };
    }

    // Проверка аутентификации
    function checkAuth() {
        const token = localStorage.getItem('authToken');
        if (!token) {
            window.location.href = '/login';
        }
    }

    // Инициализация приложения
    async function init() {
        checkAuth();
        setupEventListeners();
        await fetchData();
    }

    init();
});
